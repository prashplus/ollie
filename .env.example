# ──────────────────────────────────────────────────────────────
# Ollie Home Assistant — Environment Configuration
# Copy this file to .env and customize as needed.
# ──────────────────────────────────────────────────────────────

# ── Ollama LLM Runtime ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLIE_TEXT_MODEL=llama3.1:8b
OLLIE_VISION_MODEL=llava:7b
OLLIE_EMBEDDING_MODEL=nomic-embed-text

# ── Faster-Whisper (Speech-to-Text) ──────────────────────────
OLLIE_WHISPER_MODEL=base
# Options: tiny, base, small, medium, large-v3-turbo
OLLIE_WHISPER_DEVICE=auto
# Options: auto, cpu, cuda (uses RTX GPU if available)
OLLIE_WHISPER_COMPUTE_TYPE=auto
# Options: auto, float16 (GPU), int8 (CPU)

# ── Piper TTS (Text-to-Speech) ───────────────────────────────
OLLIE_TTS_VOICE=en_US-amy-medium
# Browse voices: https://rhasspy.github.io/piper-samples/

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
SSL_CERTFILE=certs/cert.pem
SSL_KEYFILE=certs/key.pem

# ── Storage Paths ────────────────────────────────────────────
DATABASE_PATH=data/ollie.db
CHROMA_PERSIST_DIR=data/chroma_db
DOCS_DIR=docs

# ── LangSmith Debugging (optional) ───────────────────────────
# Sign up free at https://smith.langchain.com/
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ollie-home-assistant

# ── Web Search & Live News API (optional) ────────────────────
# Get a free API key at https://tavily.com (1,000 free searches/month)
# If left empty, Ollie uses free DuckDuckGo & Google News RSS
TAVILY_API_KEY=

